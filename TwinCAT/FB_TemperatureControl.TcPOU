<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="FB_TemperatureControl" Id="{2e5689c7-fbb8-4813-adf5-b7f53dce5a5c}" SpecialFunc="None">
    <Declaration><![CDATA[
FUNCTION_BLOCK FB_TemperatureControl
VAR_INPUT
    EN : BOOL := TRUE;
    fTemperaturePv : LREAL; // temperatura mierzona
    bAutoTuneStart : BOOL;  // impuls z HMI
END_VAR
VAR_IN_OUT
    stParams : ST_TemperatureControlParams;
END_VAR
VAR_OUTPUT
    ENO : BOOL;
    fControlError : LREAL;
    fAnalogOutputPct : LREAL; // -100..100, dodatnie=grzanie, ujemne=chlodzenie
    fHeatAnalogPct : LREAL;   // 0..100
    fCoolAnalogPct : LREAL;   // 0..100
    bHeatOn : BOOL;
    bCoolOn : BOOL;
    bAutoTuneBusy : BOOL;
    bAutoTuneDone : BOOL;
    bAutoTuneError : BOOL;
END_VAR
VAR
    fbAutoTuneTimer : TON;
    bAutoTuneStartOld : BOOL := FALSE;
    bAutoTuneTimerIn : BOOL := FALSE;

    fPvFiltered : LREAL := 0.0;
    fPrevError : LREAL := 0.0;
    fIntegral : LREAL := 0.0;
    fDerivative : LREAL := 0.0;
    fPidRaw : LREAL := 0.0;
    fPidClamped : LREAL := 0.0;

    fCycleS : LREAL := 0.1;
    fOutMin : LREAL := -100.0;
    fOutMax : LREAL := 100.0;
    fDeadbandAbs : LREAL := 0.3;
    fHeatMin : LREAL := 0.0;
    fCoolMin : LREAL := 0.0;
    fFilterAlpha : LREAL := 0.2;

    fTuneStartTemp : LREAL := 0.0;
    fObserveS : LREAL := 120.0;
    fTuneElapsedS : LREAL := 0.0;
    fTuneDeltaTemp : LREAL := 0.0;
    fTuneStepPct : LREAL := 0.0;
    fTuneNoiseBand : LREAL := 0.2;
    fTuneLambdaFactor : LREAL := 1.0;
    bTuneResponseDetected : BOOL := FALSE;
    fTuneDeadTimeS : LREAL := 0.0;

    // Probkowanie odpowiedzi do dopasowania modelu FOPDT
    nTuneSampleCount : INT := 0;
    fTuneSamplePeriodS : LREAL := 1.0;
    fTuneNextSampleAtS : LREAL := 0.0;
    aTuneTimeS : ARRAY[1..600] OF LREAL;
    aTuneDeltaTemp : ARRAY[1..600] OF LREAL;

    // Zmienne dopasowania i strojenia
    nFitIdx : INT := 0;
    nTauStepIdx : INT := 0;
    fTauMinS : LREAL := 0.5;
    fTauMaxS : LREAL := 1.0;
    fTauStepS : LREAL := 0.5;
    fTauCandidateS : LREAL := 1.0;
    fTauBestS : LREAL := 1.0;
    fFitDtS : LREAL := 0.0;
    fFitPhi : LREAL := 0.0;
    fFitModel : LREAL := 0.0;
    fFitSxx : LREAL := 0.0;
    fFitSxy : LREAL := 0.0;
    fFitA : LREAL := 0.0;
    fFitABest : LREAL := 0.0;
    fFitErr : LREAL := 0.0;
    fFitBestErr : LREAL := 0.0;
    fProcessGainDegCPerPct : LREAL := 0.0;
    fLambdaS : LREAL := 1.0;
    fTiS : LREAL := 1.0;
    fTdS : LREAL := 0.0;
    fThermalResistanceKPerW : LREAL := 0.0;
    fThermalCapacityJPerK : LREAL := 0.0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF EN THEN
    fCycleS := LIMIT(0.01, stParams.fCycleTimeS, 10.0);
    fOutMin := stParams.fOutputMin;
    fOutMax := stParams.fOutputMax;
    IF fOutMin >= fOutMax THEN
        fOutMin := -100.0;
        fOutMax := 100.0;
    END_IF;

    fDeadbandAbs := ABS(stParams.fDeadband);
    fHeatMin := LIMIT(0.0, stParams.fHeatMinPct, 100.0);
    fCoolMin := LIMIT(0.0, stParams.fCoolMinPct, 100.0);
    fFilterAlpha := LIMIT(0.0, stParams.fFilterAlpha, 1.0);
    fObserveS := LIMIT(5.0, TIME_TO_LREAL(stParams.tAutoTuneObserve) / 1000.0, 3600.0);

    // Filtr PV, zeby ograniczyc szum na pochodnej PID
    fPvFiltered := (fFilterAlpha * fTemperaturePv) + ((1.0 - fFilterAlpha) * fPvFiltered);

    IF bAutoTuneStart AND NOT bAutoTuneStartOld AND stParams.bEnableAutoTune AND NOT bAutoTuneBusy THEN
        bAutoTuneBusy := TRUE;
        bAutoTuneDone := FALSE;
        bAutoTuneError := FALSE;
        bAutoTuneTimerIn := TRUE;

        fTuneStartTemp := fPvFiltered;
        fTuneElapsedS := 0.0;
        fTuneDeltaTemp := 0.0;
        fTuneStepPct := LIMIT(1.0, ABS(stParams.fAutoTuneStep), 100.0);
        fTuneNoiseBand := MAX(0.01, ABS(stParams.fAutoTuneNoiseBand));
        fTuneLambdaFactor := MAX(0.1, stParams.fAutoTuneLambdaFactor);
        bTuneResponseDetected := FALSE;
        fTuneDeadTimeS := 0.0;

        nTuneSampleCount := 0;
        fTuneSamplePeriodS := LIMIT(0.2, fObserveS / 600.0, 5.0);
        fTuneNextSampleAtS := 0.0;

        stParams.fIdentProcessGainDegCPerPct := 0.0;
        stParams.fIdentDeadTimeS := 0.0;
        stParams.fIdentTimeConstantS := 0.0;
        stParams.fIdentThermalResistanceKPerW := 0.0;
        stParams.fIdentThermalCapacityJPerK := 0.0;

        fIntegral := 0.0;
        fPrevError := 0.0;
    END_IF;
    bAutoTuneStartOld := bAutoTuneStart;

    IF bAutoTuneBusy THEN
        bAutoTuneTimerIn := TRUE;
        fTuneElapsedS := TIME_TO_LREAL(fbAutoTuneTimer.ET) / 1000.0;
        fTuneDeltaTemp := fPvFiltered - fTuneStartTemp;

        IF (nTuneSampleCount < 600) AND (fTuneElapsedS >= fTuneNextSampleAtS) THEN
            nTuneSampleCount := nTuneSampleCount + 1;
            aTuneTimeS[nTuneSampleCount] := fTuneElapsedS;
            aTuneDeltaTemp[nTuneSampleCount] := fTuneDeltaTemp;
            fTuneNextSampleAtS := fTuneNextSampleAtS + fTuneSamplePeriodS;
        END_IF;

        IF (NOT bTuneResponseDetected) AND (ABS(fTuneDeltaTemp) >= fTuneNoiseBand) THEN
            bTuneResponseDetected := TRUE;
            fTuneDeadTimeS := fTuneElapsedS;
        END_IF;

        // W trakcie autotune wymuszamy krok grzania
        fPidClamped := fTuneStepPct;
        fAnalogOutputPct := fPidClamped;
        fHeatAnalogPct := fPidClamped;
        fCoolAnalogPct := 0.0;
        bHeatOn := fHeatAnalogPct > 0.0;
        bCoolOn := FALSE;
        fControlError := 0.0;

        IF fbAutoTuneTimer.Q THEN
            bAutoTuneBusy := FALSE;
            bAutoTuneTimerIn := FALSE;
            fTuneElapsedS := TIME_TO_LREAL(fbAutoTuneTimer.ET) / 1000.0;
            fTuneDeltaTemp := fPvFiltered - fTuneStartTemp;

            IF bTuneResponseDetected AND (nTuneSampleCount >= 5) THEN
                fTauMinS := 0.5;
                fTauMaxS := MAX(fTauMinS + 0.5, fObserveS - fTuneDeadTimeS);
                fTauStepS := MAX(0.1, (fTauMaxS - fTauMinS) / 80.0);
                fFitBestErr := 1.0E+30;
                fTauBestS := fTauMinS;
                fFitABest := 0.0;

                FOR nTauStepIdx := 0 TO 80 DO
                    fTauCandidateS := fTauMinS + (INT_TO_LREAL(nTauStepIdx) * fTauStepS);
                    IF fTauCandidateS > fTauMaxS THEN
                        fTauCandidateS := fTauMaxS;
                    END_IF;

                    fFitSxx := 0.0;
                    fFitSxy := 0.0;
                    FOR nFitIdx := 1 TO nTuneSampleCount DO
                        fFitDtS := aTuneTimeS[nFitIdx] - fTuneDeadTimeS;
                        IF fFitDtS > 0.0 THEN
                            fFitPhi := 1.0 - EXP(-fFitDtS / fTauCandidateS);
                            fFitSxx := fFitSxx + (fFitPhi * fFitPhi);
                            fFitSxy := fFitSxy + (fFitPhi * aTuneDeltaTemp[nFitIdx]);
                        END_IF;
                    END_FOR;

                    IF fFitSxx > 1.0E-9 THEN
                        fFitA := fFitSxy / fFitSxx;
                        fFitErr := 0.0;
                        FOR nFitIdx := 1 TO nTuneSampleCount DO
                            fFitDtS := aTuneTimeS[nFitIdx] - fTuneDeadTimeS;
                            IF fFitDtS > 0.0 THEN
                                fFitModel := fFitA * (1.0 - EXP(-fFitDtS / fTauCandidateS));
                            ELSE
                                fFitModel := 0.0;
                            END_IF;
                            fFitErr := fFitErr + ((aTuneDeltaTemp[nFitIdx] - fFitModel) * (aTuneDeltaTemp[nFitIdx] - fFitModel));
                        END_FOR;

                        IF fFitErr < fFitBestErr THEN
                            fFitBestErr := fFitErr;
                            fTauBestS := fTauCandidateS;
                            fFitABest := fFitA;
                        END_IF;
                    END_IF;
                END_FOR;

                IF ABS(fFitABest) >= fTuneNoiseBand THEN
                    fProcessGainDegCPerPct := fFitABest / fTuneStepPct;
                    IF ABS(fProcessGainDegCPerPct) > 1.0E-6 THEN
                        stParams.fIdentProcessGainDegCPerPct := fProcessGainDegCPerPct;
                        stParams.fIdentDeadTimeS := fTuneDeadTimeS;
                        stParams.fIdentTimeConstantS := fTauBestS;

                        IF stParams.fHeaterPowerNominalW > 0.0 THEN
                            fThermalResistanceKPerW := (100.0 * ABS(fProcessGainDegCPerPct)) / stParams.fHeaterPowerNominalW;
                            IF fThermalResistanceKPerW > 1.0E-9 THEN
                                fThermalCapacityJPerK := fTauBestS / fThermalResistanceKPerW;
                            ELSE
                                fThermalCapacityJPerK := 0.0;
                            END_IF;
                        ELSE
                            fThermalResistanceKPerW := 0.0;
                            fThermalCapacityJPerK := 0.0;
                        END_IF;
                        stParams.fIdentThermalResistanceKPerW := fThermalResistanceKPerW;
                        stParams.fIdentThermalCapacityJPerK := fThermalCapacityJPerK;

                        // Strojenie IMC-PID dla modelu FOPDT
                        fLambdaS := MAX(1.0, fTuneLambdaFactor * (fTauBestS + fTuneDeadTimeS));
                        stParams.fKp := fTauBestS / (ABS(fProcessGainDegCPerPct) * (fLambdaS + fTuneDeadTimeS));
                        fTiS := MAX(0.5, fTauBestS + (0.5 * fTuneDeadTimeS));
                        fTdS := (fTauBestS * fTuneDeadTimeS) / MAX(0.001, (2.0 * fTauBestS + fTuneDeadTimeS));
                        stParams.fKi := stParams.fKp / fTiS;
                        stParams.fKd := stParams.fKp * fTdS;

                        bAutoTuneDone := TRUE;
                        bAutoTuneError := FALSE;
                    ELSE
                        bAutoTuneError := TRUE;
                    END_IF;
                ELSE
                    bAutoTuneError := TRUE;
                END_IF;
            ELSE
                bAutoTuneError := TRUE;
            END_IF;
        END_IF;
    ELSE
        bAutoTuneTimerIn := FALSE;

        fControlError := stParams.fSetpoint - fPvFiltered;
        IF stParams.bManualMode THEN
            fPidRaw := stParams.fManualOutput;
        ELSE
            fDerivative := (fControlError - fPrevError) / fCycleS;
            fPidRaw := (stParams.fKp * fControlError) + (stParams.fKi * fIntegral) + (stParams.fKd * fDerivative);

            // Anty-windup: nie integruj, gdy wyjscie nasycone i blad pcha dalej w nasycenie
            IF NOT (((fPidRaw > fOutMax) AND (fControlError > 0.0)) OR ((fPidRaw < fOutMin) AND (fControlError < 0.0))) THEN
                fIntegral := fIntegral + (fControlError * fCycleS);
            END_IF;
            fPidRaw := (stParams.fKp * fControlError) + (stParams.fKi * fIntegral) + (stParams.fKd * fDerivative);
            fPrevError := fControlError;
        END_IF;

        fPidClamped := LIMIT(fOutMin, fPidRaw, fOutMax);
        fAnalogOutputPct := fPidClamped;

        IF fPidClamped > fDeadbandAbs THEN
            fHeatAnalogPct := LIMIT(fHeatMin, fPidClamped, 100.0);
            fCoolAnalogPct := 0.0;
            bHeatOn := fHeatAnalogPct > 0.0;
            bCoolOn := FALSE;
        ELSIF fPidClamped < (-fDeadbandAbs) THEN
            fCoolAnalogPct := LIMIT(fCoolMin, ABS(fPidClamped), 100.0);
            fHeatAnalogPct := 0.0;
            bCoolOn := fCoolAnalogPct > 0.0;
            bHeatOn := FALSE;
        ELSE
            fHeatAnalogPct := 0.0;
            fCoolAnalogPct := 0.0;
            bHeatOn := FALSE;
            bCoolOn := FALSE;
        END_IF;
    END_IF;
ELSE
    // Reset bloku do stanu 0 gdy EN=FALSE
    fControlError := 0.0;
    fAnalogOutputPct := 0.0;
    fHeatAnalogPct := 0.0;
    fCoolAnalogPct := 0.0;
    bHeatOn := FALSE;
    bCoolOn := FALSE;
    bAutoTuneBusy := FALSE;
    bAutoTuneDone := FALSE;
    bAutoTuneError := FALSE;
    bAutoTuneStartOld := FALSE;
    bAutoTuneTimerIn := FALSE;
    fPvFiltered := 0.0;
    fPrevError := 0.0;
    fIntegral := 0.0;
    fDerivative := 0.0;
    fPidRaw := 0.0;
    fPidClamped := 0.0;
    fTuneStartTemp := 0.0;
    fTuneElapsedS := 0.0;
    fTuneDeltaTemp := 0.0;
    fTuneStepPct := 0.0;
    fTuneNoiseBand := 0.2;
    fTuneLambdaFactor := 1.0;
    bTuneResponseDetected := FALSE;
    fTuneDeadTimeS := 0.0;
    nTuneSampleCount := 0;
    fTuneSamplePeriodS := 1.0;
    fTuneNextSampleAtS := 0.0;
    fTauMinS := 0.5;
    fTauMaxS := 1.0;
    fTauStepS := 0.5;
    fTauCandidateS := 1.0;
    fTauBestS := 1.0;
    fFitDtS := 0.0;
    fFitPhi := 0.0;
    fFitModel := 0.0;
    fFitSxx := 0.0;
    fFitSxy := 0.0;
    fFitA := 0.0;
    fFitABest := 0.0;
    fFitErr := 0.0;
    fFitBestErr := 0.0;
    fProcessGainDegCPerPct := 0.0;
    fLambdaS := 1.0;
    fTiS := 1.0;
    fTdS := 0.0;
    fThermalResistanceKPerW := 0.0;
    fThermalCapacityJPerK := 0.0;
END_IF;

fbAutoTuneTimer(IN := bAutoTuneTimerIn, PT := stParams.tAutoTuneObserve);
ENO := EN;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
